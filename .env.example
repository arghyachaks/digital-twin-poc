# Copy to .env and edit. The app works without any LLM (offline mode), but the assistant is far smarter with one.

# auto = use local Ollama if running, else Anthropic / OpenAI if a key is set
LLM_PROVIDER=auto

# --- Local & free: install https://ollama.com, then:  ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# --- Cloud options
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Simulation speed: simulated seconds per real second
SIM_SPEED=300
PORT=8000
